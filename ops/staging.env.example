# AgentForge STAGING environment: PLACEHOLDERS ONLY. Copy to your secret store, replace every <...>, never commit real values.
# CI runs `python ops/check_config.py --profile staging` against this file's shape (with dummy values) so the template cannot drift from the application's validation.
# docs/operations.md section 21 is the staging checklist; this file shows the exact format of each name.

# --- core -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
APP_ENV=production                         # staging uses production behaviour on purpose (HTTPS-only origins, fail-closed settings)
GROQ_API_KEY=<model provider key from the secret store>
DATABASE_URL=postgresql://agentforge:<password>@db.staging.internal:5432/agentforge?sslmode=require
REDIS_URL=redis://:<password>@redis.staging.internal:6379/0
# REDIS_SENTINELS=sentinel-1.staging.internal:26379,sentinel-2.staging.internal:26379,sentinel-3.staging.internal:26379
# REDIS_SENTINEL_MASTER=agentforge
RUN_EXECUTION=api-only                     # API processes only record runs; separate `python worker.py` processes execute them
ALLOWED_HOSTS=api.staging.example.com
CORS_ALLOWED_ORIGINS=https://app.staging.example.com
MAX_REQUEST_BYTES=1048576

# --- authentication (the Next.js app signs 10-minute tokens; the API verifies them) ---------------------------------------------------------------------------------------------------------------------
AUTH_CONFIG_REQUIRED=1
AUTH_JWT_PUBLIC_KEYS={"staging-1":"-----BEGIN PUBLIC KEY-----\n<public key PEM, \n-escaped>\n-----END PUBLIC KEY-----\n"}

# --- reliability and limits (defaults shown are the application's; override only with a reason) -----------------------------------------------------------------------------------------------------------
PROVIDER_REDIS_DOWN=closed                 # the DEFAULT (shown for clarity): no provider slot is granted while the shared accounting cannot be trusted; `degrade` is an explicit opt-in that drops the global cap
PROVIDER_GLOBAL_CONCURRENCY=8
# RATE_LIMIT_PLAN_CREATE=15                # per user per minute; see docs/operations.md section 11 for the full list

# --- observability and alerting ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
LOG_FORMAT=json
METRICS_TOKEN=<at least 24 random characters>
ALERT_WEBHOOK_URL=https://hooks.staging.example.com/services/<token>     # a SECRET: webhooks embed a token
ALERT_EVAL_INTERVAL=30
BACKUP_STATUS_FILE=/var/lib/agentforge/backup-status.json                # written by ops/backup_job.py

# --- optional: the real email tool (sandbox until EMAIL_ALLOWED_DOMAINS says otherwise) -------------------------------------------------------------------------------------------------------------
# RESEND_API_KEY=<sandbox key>
# EMAIL_FROM=AgentForge <sandbox@resend.dev>
# EMAIL_ALLOWED_DOMAINS=resend.dev
